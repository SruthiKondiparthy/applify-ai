{
  "version": 2,
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/.next",
  "framework": "nextjs",  
  "installCommand": "npm ci",  
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://applify-backend.vercel.app/:path*"
    }
  ],
  "roots": {
    "frontend": "frontend"
  }
}
