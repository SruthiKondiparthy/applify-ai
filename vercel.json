{
  "version": 2,
  "projects": [
    {
      "name": "applify-frontend",
      "rootDirectory": "frontend",
      "buildCommand": "npm run build",
      "outputDirectory": ".next",
      "framework": "nextjs"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://applify-backend.vercel.app/:path*"
    }
  ]
}
